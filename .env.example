# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
#   cp .env.example .env
#
# Every value here is read at runtime on the server only. None of it is
# inlined into the browser bundle (only VITE_-prefixed vars would be, and
# this app deliberately defines none).
# ---------------------------------------------------------------------------

# --- MongoDB (required) ----------------------------------------------------
# Atlas: Database > Connect > Drivers > copy the SRV string.
# URL-encode any special characters in the password (@ -> %40, # -> %23, etc).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name. Created automatically on first write; does not need to exist.
MONGODB_DATABASE=lux_game_studio

# --- Authentication (required) ---------------------------------------------
# Signing key for admin session JWTs. Must be at least 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this invalidates every existing session (all admins are logged out).
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# --- Runtime ---------------------------------------------------------------
# Port for `npm start` (the production Node server). Ignored by `npm run dev`,
# which serves on port 8080, and by Vercel, which assigns its own.
PORT=3000

# DO NOT set NODE_ENV here.
# Vite injects variables from this file into the build, so NODE_ENV=development
# would leak into `npm run build` and emit React's *development* JSX runtime into
# the production bundle. The server then dies during SSR with
# "jsxDEV is not a function" and every page returns 500.
# Vite sets NODE_ENV correctly on its own: development for `npm run dev`,
# production for `npm run build`. Your host sets it for the running server.

# --- Deployment target (optional) ------------------------------------------
# Nitro build preset. Defaults to `node-server`, which runs anywhere Node runs
# (VPS, Docker, Railway, Render, AWS). Set to `vercel` in Vercel's project
# environment variables. Leave unset for local development.
# NITRO_PRESET=vercel

# --- Seed (optional) -------------------------------------------------------
# If both are set, `npm run seed` creates this administrator non-interactively.
# If left unset, the first visit to /admin/login offers a one-time setup form
# that creates the first admin instead. Password must be at least 8 characters.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-this-password

# --- Media uploads (optional) ----------------------------------------------
# Maximum upload size in bytes for the admin media library. Default 10 MB.
# Files are stored in MongoDB GridFS and served from /api/media/:id.
# MAX_UPLOAD_BYTES=10485760
